# Meta Marketing API — server-side only (never exposed to the browser).
# Copy to .env.local for local dev, and add the same vars in Vercel:
#   Project → Settings → Environment Variables.

# Your access token — a System User token (long-lived) is strongly preferred.
# Needs the ads_management permission on the ad account below.
META_ACCESS_TOKEN=

# Ad account to push into. "act_" prefix is optional (added automatically).
META_AD_ACCOUNT_ID=act_XXXXXXXXXX

# The Facebook Page ads run as (required).
META_PAGE_ID=

# Instagram account id for IG placements (optional).
META_INSTAGRAM_ID=

# Graph API version (optional — defaults to v23.0).
META_API_VERSION=v23.0

# ── Site password gate ──
# Shared workspace password. Unset/empty = site is open (auth disabled).
SITE_PASSWORD=
# Random string used to sign the auth cookie. Generate one for production.
AUTH_SECRET=

# ── Supabase (multi-tenant: auth + per-workspace Meta connections) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used to read Meta tokens. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Meta app (OAuth — lets each workspace connect its own ad account) ──
META_APP_ID=
META_APP_SECRET=
